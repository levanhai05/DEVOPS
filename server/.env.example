PORT=4000
# BẮT BUỘC đổi khi chạy production (chuỗi ngẫu nhiên dài)
JWT_SECRET=change-me
# Đường dẫn file SQLite (trên Render hãy gắn Disk và trỏ vào đó, ví dụ /data/hai.db)
DB_PATH=./data/hai.db
# Thư mục lưu ảnh sản phẩm upload (trên Render nên đặt cùng Disk, ví dụ /data/uploads)
UPLOAD_DIR=./data/uploads
# Danh sách origin FE được phép gọi API, ngăn cách bằng dấu phẩy. Để trống = cho phép tất cả (chỉ dùng khi dev)
CORS_ORIGIN=http://localhost:5173
# Tài khoản admin tạo lần đầu khi DB chưa có admin
ADMIN_EMAIL=admin@hai.vn
ADMIN_PASSWORD=admin123

# URL của FE, dùng để tạo liên kết đặt lại mật khẩu trong email
APP_URL=http://localhost:5173
# SMTP gửi email quên mật khẩu. Bỏ trống SMTP_HOST = chỉ in nội dung email ra console server (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HAI Shop <no-reply@hai.vn>"
